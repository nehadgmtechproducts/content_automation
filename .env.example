# ---------- Stage 3 (synthesis): which LLM writes the article + script ----------
# fal   -> uses FAL_KEY below (also powers Stage 4 video)
# anthropic / openai -> need their own key below
SYNTHESIS_PROVIDER=fal   # fal | nvidia | anthropic | openai
# nvidia: a key from build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# AI cover illustration (FLUX via the same NVIDIA key). false = always use the gradient cover.
AI_IMAGES=true
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b

ANTHROPIC_API_KEY=

# ---------- You already have this ----------
FIRECRAWL_API_KEY=

# ---------- Optional: free key, instant signup, used for B-roll ----------
# https://www.pexels.com/api/
PEXELS_API_KEY=

# ---------- Optional paid upgrades (adapters already wired) ----------
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=

# ---------- Infrastructure ----------
DATABASE_URL=postgresql+psycopg://engine:engine@localhost:5432/content_engine
REDIS_URL=redis://localhost:6379/0
MEDIA_ROOT=./media
MEDIA_RETENTION_DAYS=14

# ---------- Models ----------
SYNTHESIS_MODEL=claude-opus-5
OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=

# fal.ai — one key does both scripting and video. Needs a funded balance:
# fal.ai/dashboard/billing (a locked/empty account returns 403 on every run).
FAL_KEY=
FAL_LLM_MODEL=openai/gpt-6.1-sol

# ---------- Stage 5: Telegram approval (optional — blank skips it, topics stop at
# assets_ready) ----------
# 1. Message @BotFather on Telegram -> /newbot -> follow the prompts -> paste the token.
# 2. Create a private Telegram group or channel and add your bot to it.
# 3. Send any message in that group, then run: python -m app.cli telegram-chat-id
#    and paste the chat_id it reports below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stage 6 web export: path to the news_automation_web checkout
WEB_PROJECT_DIR=

# false (default) = articles + images only. true = also voiceover, subtitles, b-roll and a 1080x1920 MP4.
GENERATE_VIDEO=false

RENDER_IN_DOCKER=1
